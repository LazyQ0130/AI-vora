        "v = [3, 1]\n",
        "vector_sum = [u[0] + v[0], u[1] + v[1]]\n",
        "scaled = [2 * u[0], 2 * u[1]]\n",
        "print(vector_sum, scaled)\n",
        "\n",
        "# 可选：结果与边界验证\n",
