      "source": [
        "def scale(value, factor=2):\n",
        "    return value * factor\n",
        "\n",
        "print(scale(3))\n",
        "print(scale(3, factor=4))\n",
        "\n",
        "# 可选：结果与边界验证\n",
        "assert scale(3) == 6\n",
        "assert scale(3, 4) == 12\n",
        "assert scale(3, factor=0) == 0\n"
      ]
    }
  ]
